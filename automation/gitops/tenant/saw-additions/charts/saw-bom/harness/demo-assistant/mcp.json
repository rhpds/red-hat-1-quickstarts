{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "mailpit_reader": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/mcp/source-readers.mjs",
        "mailpit_reader"
      ],
      "env": {
        "MAILPIT_AUTHORIZATION": "${MAILPIT_AUTHORIZATION}"
      }
    },
    "mattermost_reader": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/mcp/source-readers.mjs",
        "mattermost_reader"
      ],
      "env": {
        "MM_TOKEN": "${MM_TOKEN}"
      }
    },
    "calendar_reader": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/mcp/source-readers.mjs",
        "calendar_reader"
      ],
      "env": {
        "CALENDAR_AUTHORIZATION": "${CALENDAR_AUTHORIZATION}"
      }
    },
    "demo_notes": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/mcp/source-readers.mjs",
        "demo_notes"
      ]
    }
  }
}
